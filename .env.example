# LLMstocks environment variables (v0.5)
# Copy this file to .env and edit. Never commit .env.

# === yfinance ===
# Minimum interval between yfinance API calls (seconds). Yahoo throttles aggressively.
YF_REQUEST_INTERVAL=0.5

# === V2 / legacy (NOT used in v0.5) ===
# Uncomment only if you've installed the optional `ashare-legacy` or `tushare`
# extras AND you have境内 network access (or VPN分流 configured for国内 IPs).
# TUSHARE_TOKEN=
# AKSHARE_HTTP_TIMEOUT=30
# AKSHARE_REQUEST_INTERVAL=0.8

# === LLMstocks project (optional) ===
# Override project root if needed; defaults to the cwd of the script.
# LLMSTOCKS_DATA_DIR=E:\LLMstocks
